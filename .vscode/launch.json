      "executable": "./nuttx.elf",
      "interface":"swd",
      "request": "attach",
      "type": "cortex-debug",
      "servertype":"openocd",
      "device": "stm32f777IIK6",
      "svdFile": "C:/Tools/HOME/STM32F7x7.svd",
      "configFiles": [
        "interface/stlink.cfg",
        "target/stm32f7x.cfg"
      ]
    }
  ]
